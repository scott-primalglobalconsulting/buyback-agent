SUPABASE_SERVICE_ROLE_KEY=
# Random secret used to hash demo client IPs (sha256(ip + SERVER_SALT)) before
# they reach the abuse-guard tables. Raw IPs never leave the analyze route.
# Set a long random value per environment; changing it resets per-IP rate
# buckets. Required by /api/analyze (demo path).
SERVER_SALT=
